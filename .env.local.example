# product-cst 월간 보고 API (/api/report/monthly). 토큰 = product-cst 의 MCP_TOKEN
PRODUCT_CST_BASE_URL=https://product-cst.example.vercel.app
PRODUCT_CST_TOKEN=

# plog 월간 운영 API (/api/report/monthly). 토큰 = plog 의 REPORT_API_TOKEN
PLOG_BASE_URL=https://plog.example.vercel.app
PLOG_TOKEN=

# plog 와 같은 Neon DB (users 읽기 + mr_* 노트 테이블)
DATABASE_URL=
# plog 와 같은 값 (세션 쿠키 포맷 호환)
SESSION_SECRET=

# 로컬 개발 전용: 1 이면 로그인 생략(전체관리자). 운영에는 넣지 않는다.
# DEV_BYPASS_AUTH=1
